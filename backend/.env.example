# Bu dosya örnek şablondur. Kopyala → .env yap → kendi değerlerini yaz.
# .env dosyası git'e girmez, bu .env.example girer.

# PostgreSQL bağlantı adresi
# Format: postgresql://KULLANICI:ŞİFRE@SUNUCU:PORT/VERİTABANI
DATABASE_URL=postgresql://postgres:SIFRENIZI_YAZIN@localhost:5432/stroke_db

# JWT imzalama anahtarı — en az 32 karakter, tahmin edilemez bir şey yaz
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=buraya-cok-uzun-ve-rastgele-bir-sifre-yaz
